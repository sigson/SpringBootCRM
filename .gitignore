# ---- Build output ----
backend/target/
frontend/dist/
frontend/node_modules/

# ---- Run state (pids and logs, written by build.sh) ----
.run/

# ---- Local H2 database ----
backend/data/
*.db
*.trace.db
*.lock.db

# ---- Local environment overrides ----
# .env.example and .env.production are committed (the latter carries the
# deployed backend's public URL); per-developer overrides are not.
.env
.env.local
.env.*.local

# ---- IDE and OS ----
.idea/
*.iml
.vscode/
.DS_Store

# ---- Crash dumps and stray logs ----
hs_err_pid*.log
replay_pid*.log
*.log
